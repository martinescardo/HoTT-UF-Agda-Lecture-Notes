#!/bin/bash

mkdir -p pdf/all

# Google Chrome is the command google-chrome on Linux and an application
# bundle on macOS. Another browser can be given with CHROME=...

if [ -z "$CHROME" ]; then
  if [ "$(uname -s)" = Darwin ]; then
    CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  else
    CHROME=google-chrome
  fi
fi

"$CHROME" --headless --print-to-pdf="pdf/all/HoTT-UF-Agda.pdf" _site/HoTT-UF-Agda.html

# # You may need "export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libgtk3-nocsd.so.0" before the following

# pdftk pdf/HoTT-UF-Agda.pdf pdf/Universes.pdf output pdf/all/HoTT-UF-Agda.pdf

cp pdf/all/HoTT-UF-Agda.pdf ~/martinescardo.github.io/HoTT-UF-in-Agda-Lecture-Notes/
