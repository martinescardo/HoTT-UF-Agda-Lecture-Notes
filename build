#!/bin/bash

./generatehtml
./illiterate
bundle exec jekyll build
mkdir -p previous-version
rm -rf previous-version/*
mv ~/martinescardo.github.io/HoTT-UF-in-Agda-Lecture-Notes/* previous-version/
cp -a  _site/index.html          ~/martinescardo.github.io/HoTT-UF-in-Agda-Lecture-Notes/
cp -a  _site/HoTT-UF-Agda.html   ~/martinescardo.github.io/HoTT-UF-in-Agda-Lecture-Notes/
cp -a  _site/Universes.html      ~/martinescardo.github.io/HoTT-UF-in-Agda-Lecture-Notes/
cp -a  _site/Agda.Primitive.html ~/martinescardo.github.io/HoTT-UF-in-Agda-Lecture-Notes/
cp -a  _site/css                 ~/martinescardo.github.io/HoTT-UF-in-Agda-Lecture-Notes/
cp -a  _site/LICENSE             ~/martinescardo.github.io/HoTT-UF-in-Agda-Lecture-Notes/
echo "Now will generate pdf from HTML"
./generatepdf
